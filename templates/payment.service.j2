[Unit]
Description=RoboShop Payment Service
Wants=network-online.target
After=network-online.target

[Service]
User=roboshop
WorkingDirectory=/app
Environment=CART_HOST=cart.sodhichebutha.online
Environment=CART_PORT=8080
Environment=USER_HOST=user.sodhichebutha.online
Environment=USER_PORT=8080
Environment=AMQP_HOST=rabbitmq.sodhichebutha.online
Environment=AMQP_USER={{ rabbitmq_user }}
EnvironmentFile=/etc/roboshop/payment.env
ExecStart=/app/.venv/bin/gunicorn --config gunicorn.conf.py --no-control-socket payment:app
SyslogIdentifier=payment
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
