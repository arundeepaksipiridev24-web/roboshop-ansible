
[Unit]
Description=RoboShop Shipping Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=roboshop
Group=roboshop
WorkingDirectory=/app

Environment="CART_ENDPOINT={{ cart_host }}:8080"
Environment="DB_HOST={{ mysql_host }}"
Environment="DB_USER=shipping"
Environment="DB_PASSWORD={{ shipping_db_password }}"
Environment="JAVA_HOME={{ java25_home }}"

ExecStart={{ java25_home }}/bin/java -jar /app/shipping.jar

SyslogIdentifier=shipping
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
